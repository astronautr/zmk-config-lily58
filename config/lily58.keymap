#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define CAPS_CANCEL_LAYER 5
#define CAPS_STICKY_TIMEOUT_MS 2147483647

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        caps_oneshot: caps_oneshot {
            compatible = "zmk,behavior-macro";
            label = "CAPS_ONESHOT";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&caps_sticky CAPS &caps_cancel_layer CAPS_CANCEL_LAYER>;
        };
    };

    behaviors {
        ss_hs_modmorph: ss_hs_modmorph {
            compatible = "zmk,behavior-mod-morph";
            label = "SS_HS_MODMORPH";
            bindings = <&kp M>, <&kp RIGHT_BRACKET>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        kh_hs_tapdance: kh_hs_tapdance {
            compatible = "zmk,behavior-tap-dance";
            label = "KH_HS_TAPDANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        caps_sticky: caps_sticky {
            compatible = "zmk,behavior-sticky-key";
            label = "CAPS_STICKY";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <CAPS_STICKY_TIMEOUT_MS>;
        };

        caps_cancel_layer: caps_cancel_layer {
            compatible = "zmk,behavior-sticky-key";
            label = "CAPS_CANCEL_LAYER";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <CAPS_STICKY_TIMEOUT_MS>;
            quick-release;
        };

        fn2_caps: fn2_caps {
            compatible = "zmk,behavior-hold-tap";
            label = "FN2_CAPS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            bindings = <&mo>, <&caps_oneshot>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |FN2/CAPS| A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC                          &kp N1  &kp N2  &kp N3     &kp N4        &kp N5                                                 &kp N6          &kp N7        &kp N8           &kp N9            &kp N0             &kp BACKSPACE
&kp TAB                          &kp Q   &kp W   &kp E      &kp R         &kp T                                                  &kp Y           &kp U         &kp I            &kp O             &kp P              &kp MINUS
&fn2_caps 2 0                    &kp A   &kp S   &kp D      &kp F         &kp G                                                  &kp H           &kp J         &kp K            &kp L             &kp FSLH           &lt 3 ENTER
&mt LEFT_SHIFT LEFT_PARENTHESIS  &kp Z   &kp X   &kp C      &kp V         &kp B         &kp COMMA      &kp DOT                   &kp N           &kp M         &kp SEMI         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &mt RSHFT RIGHT_PARENTHESIS
                                                 &kp LCTRL  &kp LEFT_ALT  &kp LEFT_GUI  &lt 3 SPACE    &mt RIGHT_ALT LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
            >;
        };

        win_layer {
            bindings = <
&kp ESC         &kp N1  &kp N2  &kp N3     &kp N4         &kp N5                                               &kp N6          &kp N7        &kp N8           &kp N9            &kp N0             &kp BACKSPACE
&kp TAB         &kp Q   &kp W   &kp E      &kp R          &kp T                                                &kp Y           &kp U         &kp I            &kp O             &kp P              &kp MINUS
&mo 2           &kp A   &kp S   &kp D      &kp F          &kp G                                                &kp H           &kp J         &kp K            &kp L             &kp SLASH          &lt 3 ENTER
&kp LEFT_SHIFT  &kp Z   &kp X   &kp C      &kp V          &kp B         &kp COMMA    &kp DOT                   &kp N           &kp M         &kp SEMI         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp RSHFT
                                &kp LCTRL  &kp LEFT_META  &kp LEFT_ALT  &kp SPACE    &mt RIGHT_ALT LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW
            >;
        };

        fn2_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans  &trans            &trans          &trans             &trans         &mo 4                                      &trans         &trans          &trans           &trans                &trans                 &kp DELETE
&trans  &kp SINGLE_QUOTE  &kp UP_ARROW    &kp DOUBLE_QUOTES  &kp GRAVE      &kp TILDE                                  &trans         &trans          &kp C_VOLUME_UP  &trans                &kp PLUS               &kp EQUAL
&trans  &kp LEFT_ARROW    &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp BACKSPACE  &trans                                     &kp DELETE     &kp C_PREVIOUS  &kp C_VOL_DN     &kp C_NEXT            &kp BACKSLASH          &mo 4
&trans  &kp EXCLAMATION   &kp AT_SIGN     &kp HASH           &kp DOLLAR     &kp PERCENT  &kp RA(COMMA)    &kp RA(DOT)  &kp CARET      &kp AMPERSAND   &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
                                          &trans             &trans         &trans       &kp ENTER        &kp HOME     &kp PAGE_DOWN  &kp PAGE_UP     &kp END
            >;
        };

        fn3_layer {
            bindings = <
&trans            &trans        &trans        &trans        &trans  &trans                    &trans  &trans  &kp F10  &kp F11  &kp F12  &trans
&kp C_PLAY_PAUSE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans                    &trans  &trans  &kp F7   &kp F8   &kp F9   &trans
&kp SPACE         &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans  &trans                    &trans  &trans  &kp F4   &kp F5   &kp F6   &trans
&trans            &kp N7        &kp N8        &kp N9        &kp N0  &trans  &trans    &trans  &trans  &trans  &kp F1   &kp F2   &kp F3   &trans
                                              &trans        &trans  &trans  &trans    &mo 4   &trans  &trans  &trans
            >;
        };

        fn4_layer {
            bindings = <
&trans  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                                 &trans  &trans  &trans       &trans  &trans  &trans
&trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                                &trans  &trans  &trans       &trans  &trans  &trans
&trans  &trans         &trans         &trans         &trans         &trans                                       &trans  &trans  &trans       &trans  &trans  &trans
&trans  &trans         &trans         &trans         &trans         &trans         &bt BT_CLR    &bt BT_CLR_ALL  &trans  &trans  &trans       &trans  &trans  &trans
                                      &bootloader    &trans         &trans         &to 0         &to 1           &trans  &trans  &bootloader
            >;
        };

        caps_cancel_layer {
            // A second tap sends a harmless keycode that releases both sticky behaviors.

            bindings = <
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&kp K_CANCEL  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
